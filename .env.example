# Copy to `.env` and fill in from your Supabase project settings (API section).
#
# EXPO_PUBLIC_* variables are embedded in the shipped JS bundle. Everything here
# is therefore PUBLIC. The anon key is safe to expose only because Row Level
# Security restricts what it can reach — which is why RLS is enabled on every
# table in migration 0001.
#
# NEVER put the service_role key or any AI provider key in this file. Those go in
# Supabase Edge Function secrets, server-side only.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Used only by `npm run db:types`, not at runtime.
EXPO_PUBLIC_SUPABASE_PROJECT_ID=your-project-ref
